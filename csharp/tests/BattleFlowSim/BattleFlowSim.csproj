  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BattleFlowSim</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\state\BattleFlowCore.cs" />
    <Compile Include="..\..\state\WorldStateCore.cs" />
    <Compile Include="..\..\drama\DeferredActionCore.cs" />
