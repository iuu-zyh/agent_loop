<Project Sdk="Microsoft.NET.Sdk">

  <!-- `world_ai_action` 该走哪条链的判定核（10-27）。
       **故意独立于主工程**：主工程是 net472 + Unity/IL2CPP 引用（WSL 里跑不起来），
       而 `AiActionTargetCore` 是刻意做成零 Unity 依赖的纯逻辑，所以这里直接把源码链接进来
       编成 net8.0 控制台程序（与 TeamJoinCoreTests / BattleFlowSim 同一套路）。

       为什么必须有：这几条判据错在真机上**全是静默的** ——
         · `mode` 拼错 ⇒ 静默走 solo，模型以为切到了 together；
         · `spar` 配 NPC ⇒ 若落到 NpcDuel，那是真战斗（重伤/击杀/缴物），却按"切磋"回话；
         · `mode` 配空 target ⇒ 静默忽略，模型以为"请玩家一起上"，实际只有 NPC 自己动手。
       都没法靠"进游戏打一次"稳定复现。

       跑法：python3 scripts/dev/run_csharp_tests.py（加 only 参数可只跑本工程：AiActionTargetCoreTests） -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AiActionTargetCoreTests</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测源码：与模组编译的是同一个文件，不是副本 -->
    <Compile Include="..\..\state\AiActionTargetCore.cs" />
  </ItemGroup>

</Project>
