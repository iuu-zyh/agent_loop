<Project Sdk="Microsoft.NET.Sdk">

  <!-- 微信式时间分隔行判档（TimeSepCore）+ 行首戳解析（BubbleTextCore.TryParseLeadStamp）
       的单元测试。与 BubbleTextTests 同款套路：被测源码**链接**进 net8.0 控制台工程，
       `dotnet run` 直接跑（零 Unity、零游戏类型）。

       跑法（WSL，走 Windows 的 dotnet）：
          python3 scripts/dev/run_csharp_tests.py 加 only 参数只跑本工程

       ⚠ 诚实边界：这里只测**判档与解析规则**。"分隔行有没有接上、接的是不是玩家行
         渲染口"由 Python 侧源码契约测试 tests/test_time_separator_contract.py 锁在
         真实 ChatWindow.cs 上。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TimeSepCoreTests</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\UI\TimeSepCore.cs" />
    <Compile Include="..\..\UI\BubbleTextCore.cs" />
  </ItemGroup>

</Project>
