<Project Sdk="Microsoft.NET.Sdk">

  <!-- 剧情账本（DramaLedgerCore）+ 见闻渲染（DungeonDramaCore）的单元测试。
       **故意独立于主工程**：主工程是 net472 + Unity/IL2CPP 引用（WSL 里跑不起来），
       而这两个核是刻意做成零 Unity 依赖的纯逻辑，所以这里直接把源码链接进来编成
       net8.0 控制台程序（与 DramaSegmentCoreTests 同一套路）。

       为什么必须有：账本"记漏了"和"取错了"在真机上**全是静默的** ——
         · 判不出归属的页没记 ⇒ 日志一片正常，只是"进副本那一幕"永远缺席；
         · 取区间取错（用了时间窗 / 最后一根钉子选错）⇒ 履历里剧情为空或多半段；
         · 裁容量时没留痕 ⇒ 内容断了但看不出来。
       这些都不可能靠"进游戏打一场"稳定复现（进副本那一刻才知道 NPC 是谁），
       所以判据表必须由测试锁住。

       跑法：python3 scripts/dev/run_csharp_tests.py（加 only 参数可只跑本工程：DramaLedgerCoreTests）
       脚本会先清 obj/bin 强制重编；失败时进程退出码非 0。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DramaLedgerCoreTests</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测源码：与模组编译的是同一个文件，不是副本 -->
    <Compile Include="..\..\drama\DramaLedgerCore.cs" />
    <Compile Include="..\..\drama\DungeonDramaCore.cs" />
  </ItemGroup>

</Project>
