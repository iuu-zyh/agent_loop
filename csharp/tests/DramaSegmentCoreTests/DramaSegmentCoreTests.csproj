<Project Sdk="Microsoft.NET.Sdk">

  <!-- 剧情相遇分段器（DramaSegmentCore）的单元测试。**故意独立于主工程**：
       主工程是 net472 + Unity/IL2CPP 引用（WSL 里跑不起来），而 DramaSegmentCore 是刻意做成
       零 Unity 依赖的纯逻辑，所以这里直接把它当源码链接进来编成 net8.0 控制台程序。

       为什么要有这个工程：分段判据一旦写错，表现全是**静默**的——话被并进别人的链、
       战后那两句被切成新的一段、反复点对话把同一段投三遍。这些在实机上只看到"NPC 说话怪怪的"，
       没有异常、没有报错。所以判据表必须被测试锁住，不能靠每次进游戏打一场来验。

       跑法：python3 scripts/dev/run_csharp_tests.py（加 only 参数可只跑本工程：DramaSegmentCoreTests）
       脚本会先清 obj/bin 强制重编；失败时进程退出码非 0。
       注意：XML 注释里不能出现连续两个减号（写命令参数时用文字代替），本行下方即为此坑。

       注意：主工程 csproj 是显式 Compile 列表 + `drama\*.cs` 通配，本目录不在通配范围内，
       所以加这个工程不会影响模组构建。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DramaSegmentCoreTests</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测源码：与模组编译的是同一个文件，不是副本 -->
    <Compile Include="..\..\drama\DramaSegmentCore.cs" />
  </ItemGroup>

</Project>
