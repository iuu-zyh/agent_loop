<Project Sdk="Microsoft.NET.Sdk">

  <!-- 手动好友「精确身份」（ContactStore 的 name → unitID 镜像）单元测试。
       **故意独立于主工程**，理由与同目录另外三个工程相同：主工程是 net472 + Unity/IL2CPP 引用
       （WSL 里跑不起来），而 `ContactStore` 是刻意做成**零 Unity 依赖**的纯托管静态层
       （只用 System + System.Collections.Generic），所以直接把源文件链接进来编成 net8.0
       控制台程序即可，不需要 Unity、不需要游戏。

       为什么这个镜像值得单独测：它是"这个手动好友到底是谁"的唯一内存真相。
       它一旦走偏，症状全是**静默**的 ——
         ① 该记住的 unitID 没记住 → 退回按名全图猜，重名时把别人的档案端给模型；
         ② 不该清的时候清了 → 一次不带 ID 的调用就把已有的精确身份抹掉，
            而界面上完全看不出来（名字还在、按钮还亮）。

       跑法（WSL，走 Windows 的 dotnet）：
          python3 scripts/dev/run_csharp_tests.py            （加 quiet 只看最后一行结论）
       失败时进程退出码非 0。该脚本会先清 obj/bin 强制重编 —— `dotnet run` 是增量构建，
       变异验证在同一秒内反复改源码时会被"无需重编"骗过去（踩过）。

       注意：主工程 csproj 是显式 <Compile Include> 列表 + `UI\*.cs` 通配，
       本目录不在通配范围内，所以加这个工程**不会**影响模组构建。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ManualIdentityTests</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测源码：与模组编译的是**同一个文件**，不是副本 -->
    <Compile Include="..\..\contacts\ContactStore.cs" />
  </ItemGroup>

</Project>
