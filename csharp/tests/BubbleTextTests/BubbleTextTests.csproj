<Project Sdk="Microsoft.NET.Sdk">

  <!-- 气泡正文整形核（BubbleTextCore）的单元测试。**故意独立于主工程**：
       主工程是 net472 + Unity/IL2CPP 引用（WSL 里跑不起来），而 BubbleTextCore 是刻意做成
       零 Unity / 零游戏类型的纯逻辑，所以这里直接把它当源码链接进来编成 net8.0 控制台程序，
       用 `dotnet run` 就能在开发机上跑（不需要 Unity、不需要游戏）。

       跑法（WSL，走 Windows 的 dotnet）：
          python3 scripts/dev/run_csharp_tests.py               （加 quiet 开关只看最后一行结论）
          python3 scripts/dev/run_csharp_tests.py  加 only 参数只跑本工程（变异验证用，省时间）
       失败时进程退出码非 0。该脚本会先清 obj/bin 强制重编 —— `dotnet run` 是增量构建，
       变异验证在同一秒内反复改源码时会被"无需重编"骗过去（踩过）。

       ⚠ 诚实边界：这里只测**规则**（哪些行被丢、哪些换行被折、边界字符算不算空白）。
         "有没有接上、接的是不是那四个写泡点"由 Python 侧源码契约测试
         tests/test_bubble_text_contract.py 锁在真实 ChatWindow.cs / ChatItemViews.cs 上 ——
         两边合起来才完整（单测绿 + 没接上 = 用户看到的空行一点没少）。

       注意：主工程 csproj 是显式 <Compile Include> 列表 + `UI\*.cs` 通配，
       本目录不在通配范围内，所以加这个工程**不会**影响模组构建。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BubbleTextTests</AssemblyName>
    <RootNamespace>AgentLoopBridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测源码：与模组编译的是**同一个文件**，不是副本 -->
    <Compile Include="..\..\UI\BubbleTextCore.cs" />
  </ItemGroup>

</Project>
